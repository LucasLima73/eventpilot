{
  "name": "@pilotevent/broker-redpanda",
  "version": "0.0.2",
  "description": "Redpanda/Kafka broker adapter for EventPilot.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@pilotevent/plugin-api": "workspace:*",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "testcontainers": "^12.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git",
    "directory": "packages/broker-redpanda"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  }
}
