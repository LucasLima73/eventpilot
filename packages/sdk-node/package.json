{
  "name": "@pilotevent/sdk-node",
  "version": "0.0.2",
  "description": "Lightweight Node agent for EventPilot: propagates correlation_id/causation_id on kafkajs producers/consumers and reports traces to the control plane.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "kafkajs": "^2.2.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  }
}
