{
  "name": "eventpilot",
  "version": "0.0.1",
  "description": "EventPilot CLI — scaffold and run an event-driven architecture in one command.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "eventpilot": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@eventpilot/broker-redpanda": "workspace:*",
    "@eventpilot/core": "workspace:*",
    "@eventpilot/gen-node": "workspace:*",
    "@eventpilot/plugin-api": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
