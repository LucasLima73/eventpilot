{
  "name": "eventpilot",
  "version": "0.0.5",
  "description": "EventPilot CLI — scaffold and run an event-driven architecture in one command.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "eventpilot": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@asyncapi/parser": "^3.6.3",
    "@clack/prompts": "^0.7.0",
    "@pilotevent/broker-redpanda": "workspace:*",
    "@pilotevent/control-plane-api": "workspace:*",
    "@pilotevent/core": "workspace:*",
    "@pilotevent/feature-dlq": "workspace:*",
    "@pilotevent/feature-outbox": "workspace:*",
    "@pilotevent/gen-java": "workspace:*",
    "@pilotevent/gen-node": "workspace:*",
    "@pilotevent/plugin-api": "workspace:*",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "pg": "^8.13.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  }
}
