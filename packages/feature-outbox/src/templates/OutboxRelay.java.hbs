package com.eventpilot.generated;

import org.apache.kafka.clients.producer.KafkaProducer;
import org.apache.kafka.clients.producer.Producer;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.header.internals.RecordHeader;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.Properties;

/**
 * Polls the outbox table for unpublished rows and delivers them to the broker. Run one of
 * these per service alongside its producer/consumer — this is what actually gets events out
 * of the outbox table written by Outbox.writeOutbox and onto the broker. Mirrors
 * @pilotevent/feature-outbox's Node template (outbox-relay.ts.hbs).
 */
public final class OutboxRelay implements AutoCloseable {
  private final String jdbcUrl;
  private final String jdbcUser;
  private final String jdbcPassword;
  private final Producer<String, String> producer;
  private volatile boolean running = true;

  public OutboxRelay(String brokers, String jdbcUrl, String jdbcUser, String jdbcPassword) {
    this.jdbcUrl = jdbcUrl;
    this.jdbcUser = jdbcUser;
    this.jdbcPassword = jdbcPassword;

    Properties props = new Properties();
    props.put("bootstrap.servers", brokers);
    props.put("key.serializer", "org.apache.kafka.common.serialization.StringSerializer");
    props.put("value.serializer", "org.apache.kafka.common.serialization.StringSerializer");
    this.producer = new KafkaProducer<>(props);
  }

  public void start(long pollIntervalMs) throws Exception {
    while (running) {
      tick();
      Thread.sleep(pollIntervalMs);
    }
  }

  public void stop() {
    running = false;
  }

  private void tick() throws Exception {
    try (Connection connection = DriverManager.getConnection(jdbcUrl, jdbcUser, jdbcPassword)) {
      connection.setAutoCommit(false);
      String selectSql =
          "SELECT id, topic, key, payload, correlation_id, causation_id FROM outbox "
              + "WHERE published_at IS NULL ORDER BY id LIMIT 50 FOR UPDATE SKIP LOCKED";

      try (PreparedStatement select = connection.prepareStatement(selectSql);
          ResultSet rs = select.executeQuery()) {
        while (rs.next()) {
          long id = rs.getLong("id");
          String topic = rs.getString("topic");
          String key = rs.getString("key");
          String payload = rs.getString("payload");
          String correlationId = rs.getString("correlation_id");
          String causationId = rs.getString("causation_id");

          ProducerRecord<String, String> record = new ProducerRecord<>(topic, key, payload);
          if (correlationId != null) {
            record.headers().add(new RecordHeader("x-correlation-id", correlationId.getBytes()));
          }
          if (causationId != null) {
            record.headers().add(new RecordHeader("x-causation-id", causationId.getBytes()));
          }
          producer.send(record).get();

          try (PreparedStatement update =
              connection.prepareStatement("UPDATE outbox SET published_at = now() WHERE id = ?")) {
            update.setLong(1, id);
            update.executeUpdate();
          }
        }
      }
      connection.commit();
    }
  }

  @Override
  public void close() {
    producer.close();
  }
}
