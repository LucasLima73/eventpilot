import type { ClientBase } from "pg";

export const OUTBOX_MIGRATION_SQL = `{{{migrationSql}}}`;

export interface OutboxEvent {
  topic: string;
  key?: string;
  payload: unknown;
  headers?: Record<string, string>;
  correlationId?: string;
  causationId?: string;
}

/**
 * Inserts an event into the outbox table using the caller's own `client` —
 * run this inside the same transaction as the business data change it
 * belongs to, so the two commit (or roll back) together. `startOutboxRelay`
 * (outbox-relay.ts) delivers rows from here to the broker asynchronously.
 */
export async function writeOutbox(client: ClientBase, event: OutboxEvent): Promise<void> {
  await client.query(
    `INSERT INTO outbox (topic, key, payload, headers, correlation_id, causation_id)
     VALUES ($1, $2, $3, $4, $5, $6)`,
    [
      event.topic,
      event.key ?? null,
      JSON.stringify(event.payload),
      JSON.stringify(event.headers ?? {}),
      event.correlationId ?? null,
      event.causationId ?? null,
    ],
  );
}
