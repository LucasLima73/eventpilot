package com.eventpilot.generated;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;

/**
 * Writes an event into the outbox table using the caller's own `connection` — run this inside
 * the same transaction as the business data change it belongs to, so the two commit (or roll
 * back) together. OutboxRelay delivers rows from here to the broker asynchronously. Mirrors
 * @pilotevent/feature-outbox's Node template (outbox.ts.hbs).
 */
public final class Outbox {
  public static final String MIGRATION_SQL = """
      {{{migrationSql}}}
      """;

  private Outbox() {}

  public static void writeOutbox(
      Connection connection,
      String topic,
      String key,
      String payloadJson,
      String correlationId,
      String causationId)
      throws SQLException {
    String sql =
        "INSERT INTO outbox (topic, key, payload, headers, correlation_id, causation_id) "
            + "VALUES (?, ?, ?::jsonb, '{}'::jsonb, ?, ?)";
    try (PreparedStatement stmt = connection.prepareStatement(sql)) {
      stmt.setString(1, topic);
      stmt.setString(2, key);
      stmt.setString(3, payloadJson);
      stmt.setString(4, correlationId);
      stmt.setString(5, causationId);
      stmt.executeUpdate();
    }
  }
}
