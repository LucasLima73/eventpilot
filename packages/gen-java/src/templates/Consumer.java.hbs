  public void start(MessageHandler handler) throws InterruptedException {
    while (running) {
      ConsumerRecords<String, String> records = consumer.poll(Duration.ofMillis(500));
      for (ConsumerRecord<String, String> record : records) {
        String correlationId = headerValue(record, "x-correlation-id");
