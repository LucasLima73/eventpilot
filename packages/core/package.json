{
  "name": "@pilotevent/core",
  "version": "0.0.1",
  "description": "eventpilot.yaml schema, loader and plugin registry.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pilotevent/plugin-api": "workspace:*",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  }
}
