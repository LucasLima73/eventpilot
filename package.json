{
  "name": "eventpilot-monorepo",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && pnpm -r publish --access public --no-git-checks",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^7.0.2"
  }
}
