{
  "name": "@pilotevent/control-plane-api",
  "version": "0.0.4",
  "description": "EventPilot control plane: serves eventpilot.yaml config, live topic metadata and a WebSocket event feed to the dashboard.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "eventpilot-control-plane": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @pilotevent/dashboard build && tsc -p tsconfig.json && mkdir -p dist/public && cp -r ../dashboard/dist/. dist/public/ && chmod +x dist/bin.js",
    "dev": "tsx watch src/bin.ts",
    "start": "node dist/bin.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pilotevent/broker-redpanda": "workspace:*",
    "@pilotevent/core": "workspace:*",
    "@pilotevent/plugin-api": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "fastify": "^4.28.1",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasLima73/eventpilot.git",
    "directory": "apps/control-plane-api"
  },
  "homepage": "https://github.com/LucasLima73/eventpilot#readme",
  "bugs": {
    "url": "https://github.com/LucasLima73/eventpilot/issues"
  }
}
